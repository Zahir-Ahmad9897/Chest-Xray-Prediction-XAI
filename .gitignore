# ─────────────────────────────────────────────────────────────
#  Chest X-Ray Pneumonia XAI — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environment ─────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Distribution / Packaging ────────────────────────────────
build/
dist/
*.egg-info/
*.egg
*.whl
*.manifest
*.spec

# ── PyTorch / Model Weights ─────────────────────────────────
model_weights/
model/
*.pt
*.pth
*.onnx
*.bin

# ── Jupyter Notebooks ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS Generated Files ──────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Environment Variables ───────────────────────────────────
.env
.env.*
!.env.example

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# ── Testing / Coverage ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Misc ────────────────────────────────────────────────────
*.bak
*.tmp
*.temp